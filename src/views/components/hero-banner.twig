{#
  ============================================================
  components/hero-banner.twig
  Hero Banner / Main Slider — Salla Twilight Component
  Usage: {% include 'components.hero-banner' %}
  ============================================================
#}

{# ---------- 1. Resolve slides source (dynamic vs static) ---------- #}
{% set hb_slides = [] %}

{% if slides is defined and slides|length > 0 %}
  {% set hb_slides = slides %}
{% elseif banners is defined and banners|length > 0 %}
  {% set hb_slides = banners %}
{% endif %}

{% set hb_count = hb_slides|length %}
{% set hb_uid   = random(1000, 9999) %}

{# ============================================================
   STYLES
   ============================================================ #}
<style>
  /* ---------- Tokens ---------- */
  .hb-hero{
    --hb-cream:#FBF6EF;
    --hb-cream-2:#F3E7D7;
    --hb-gold:#C9A227;
    --hb-gold-soft:#E3C87A;
    --hb-bronze:#A9763F;
    --hb-bronze-2:#8A5E2E;
    --hb-ink:#241B14;
    --hb-ink-soft:#5F4E3F;
    --hb-ease:cubic-bezier(.22,.61,.36,1);
    --hb-shadow:0 18px 44px -18px rgba(90,60,25,.55);

    position:relative;
    isolation:isolate;
    overflow:hidden;
    background:var(--hb-cream);
    color:var(--hb-ink);
    direction:rtl;
    text-align:right;
    font-family:inherit;
    -webkit-font-smoothing:antialiased;
  }
  .hb-hero *,
  .hb-hero *::before,
  .hb-hero *::after{ box-sizing:border-box; }

  /* ---------- Shared content shell ---------- */
  .hb-hero__content{
    position:relative;
    z-index:2;
    width:100%;
    max-width:1320px;
    margin-inline:auto;
    padding:clamp(48px,7vw,96px) clamp(20px,6vw,72px);
    display:flex;
    justify-content:flex-start; /* RTL → starts from the right */
  }
  .hb-hero__inner{
    max-width:600px;
    text-align:right;
  }

  /* ---------- Ornamental rule ---------- */
  .hb-hero__rule{
    display:block;
    position:relative;
    width:74px;
    height:1px;
    margin:0 0 24px;
    background:linear-gradient(to left, var(--hb-gold), rgba(201,162,39,0));
  }
  .hb-hero__rule::after{
    content:"";
    position:absolute;
    inset-inline-start:-1px;
    top:50%;
    width:7px;
    height:7px;
    transform:translateY(-50%) rotate(45deg);
    background:var(--hb-gold);
    box-shadow:0 0 0 4px rgba(201,162,39,.15);
  }

  /* ---------- Typography ---------- */
  .hb-hero__title{
    margin:0 0 18px;
    font-family:"Amiri","Playfair Display",Georgia,"Times New Roman",serif;
    font-weight:700;
    font-size:clamp(30px,5vw,60px);
    line-height:1.18;
    letter-spacing:0;
    color:#FFF9F0;
    text-shadow:0 2px 34px rgba(0,0,0,.4);
  }
  .hb-hero__subtitle{
    margin:0 0 32px;
    font-family:inherit;
    font-size:clamp(14px,1.55vw,18px);
    font-weight:400;
    line-height:1.9;
    max-width:52ch;
    color:rgba(255,249,240,.84);
    text-shadow:0 1px 18px rgba(0,0,0,.3);
  }

  /* ---------- CTA ---------- */
  .hb-hero__cta{
    display:inline-flex;
    align-items:center;
    gap:12px;
    padding:15px 34px;
    border-radius:999px;
    border:1px solid rgba(255,255,255,.38);
    background:linear-gradient(135deg,var(--hb-gold-soft) 0%,var(--hb-gold) 46%,var(--hb-bronze) 100%);
    color:#2A1D10;
    font-family:inherit;
    font-size:15px;
    font-weight:700;
    line-height:1;
    text-decoration:none;
    white-space:nowrap;
    box-shadow:var(--hb-shadow), inset 0 1px 0 rgba(255,255,255,.55);
    transition:transform .35s var(--hb-ease), box-shadow .35s var(--hb-ease), filter .35s var(--hb-ease);
  }
  .hb-hero__cta:hover,
  .hb-hero__cta:focus-visible{
    transform:translateY(-2px);
    filter:brightness(1.06);
    box-shadow:0 24px 50px -18px rgba(169,118,63,.95), inset 0 1px 0 rgba(255,255,255,.6);
    outline:none;
  }
  .hb-hero__cta:active{ transform:translateY(0); }
  .hb-hero__cta svg{
    width:18px;
    height:18px;
    flex:none;
    transition:transform .35s var(--hb-ease);
  }
  .hb-hero__cta:hover svg{ transform:translateX(-4px); }

  /* ============================================================
     SLIDER MODE
     ============================================================ */
  .hb-hero__viewport{
    position:relative;
  }
  .hb-hero__track{
    display:flex;
    overflow-x:auto;
    overflow-y:hidden;
    scroll-snap-type:x mandatory;
    -webkit-overflow-scrolling:touch;
    scrollbar-width:none;
    -ms-overflow-style:none;
  }
  .hb-hero__track::-webkit-scrollbar{ display:none; }

  .hb-hero__slide{
    position:relative;
    flex:0 0 100%;
    width:100%;
    min-width:100%;
    min-height:clamp(430px,64vh,720px);
    display:flex;
    align-items:center;
    overflow:hidden;
    scroll-snap-align:center;
    scroll-snap-stop:always;
    background:linear-gradient(135deg,var(--hb-cream-2),var(--hb-cream));
  }

  .hb-hero__media{
    position:absolute;
    inset:0;
    z-index:0;
  }
  .hb-hero__media img{
    display:block;
    width:100%;
    height:100%;
    object-fit:cover;
    object-position:center;
  }

  .hb-hero__scrim{
    position:absolute;
    inset:0;
    z-index:1;
    pointer-events:none;
    background:
      linear-gradient(to left,
        rgba(28,20,14,.90) 0%,
        rgba(28,20,14,.66) 34%,
        rgba(28,20,14,.22) 66%,
        rgba(28,20,14,.04) 100%),
      linear-gradient(to top,
        rgba(28,20,14,.50) 0%,
        rgba(28,20,14,0) 58%);
  }

  /* ---------- Navigation arrows ---------- */
  .hb-hero__nav{
    position:absolute;
    top:50%;
    transform:translateY(-50%);
    z-index:5;
    display:grid;
    place-items:center;
    width:48px;
    height:48px;
    padding:0;
    border-radius:50%;
    border:1px solid rgba(227,200,122,.45);
    background:rgba(28,20,14,.32);
    -webkit-backdrop-filter:blur(10px);
    backdrop-filter:blur(10px);
    color:#F6E7C8;
    cursor:pointer;
    appearance:none;
    transition:background .3s var(--hb-ease), border-color .3s var(--hb-ease), transform .3s var(--hb-ease);
  }
  .hb-hero__nav:hover,
  .hb-hero__nav:focus-visible{
    background:rgba(201,162,39,.42);
    border-color:var(--hb-gold);
    outline:none;
  }
  .hb-hero__nav--prev{ inset-inline-start:clamp(12px,2.5vw,28px); }
  .hb-hero__nav--next{ inset-inline-end:clamp(12px,2.5vw,28px); }

  /* ---------- Dots ---------- */
  .hb-hero__dots{
    position:absolute;
    inset-inline:0;
    bottom:clamp(16px,3vw,30px);
    z-index:5;
    display:flex;
    justify-content:center;
    align-items:center;
    gap:10px;
    padding:0;
    margin:0;
    list-style:none;
  }
  .hb-hero__dot{
    width:9px;
    height:9px;
    padding:0;
    border:0;
    border-radius:50%;
    background:rgba(255,249,240,.38);
    cursor:pointer;
    appearance:none;
    transition:width .35s var(--hb-ease), background .35s var(--hb-ease), border-radius .35s var(--hb-ease);
  }
  .hb-hero__dot:hover{ background:rgba(255,249,240,.65); }
  .hb-hero__dot.is-active{
    width:32px;
    border-radius:999px;
    background:linear-gradient(90deg,var(--hb-gold-soft),var(--hb-gold));
  }

  /* ============================================================
     STATIC FALLBACK MODE
     ============================================================ */
  .hb-hero--static{
    background:
      radial-gradient(1100px 620px at 88% 8%, rgba(201,162,39,.20), transparent 62%),
      radial-gradient(760px 520px at 6% 94%, rgba(169,118,63,.16), transparent 60%),
      linear-gradient(160deg,#FDF9F3 0%,#F6EBDC 52%,#EFE0CB 100%);
    color:var(--hb-ink);
  }

  .hb-hero__pattern{
    position:absolute;
    inset:0;
    z-index:0;
    width:100%;
    height:100%;
    opacity:.5;
    pointer-events:none;
    mask-image:radial-gradient(120% 100% at 50% 40%, #000 20%, transparent 78%);
    -webkit-mask-image:radial-gradient(120% 100% at 50% 40%, #000 20%, transparent 78%);
  }

  .hb-hero--static .hb-hero__content{
    display:grid;
    grid-template-columns:minmax(0,1.05fr) minmax(0,.95fr);
    align-items:center;
    gap:clamp(24px,5vw,64px);
    padding-block:clamp(56px,8vw,110px);
  }
  .hb-hero--static .hb-hero__inner{ max-width:620px; }

  .hb-hero--static .hb-hero__title{
    color:var(--hb-bronze-2);
    text-shadow:none;
  }
  @supports ((-webkit-background-clip:text) or (background-clip:text)){
    .hb-hero--static .hb-hero__title{
      color:transparent;
      background:linear-gradient(118deg,#7A5228 0%,#C9A227 46%,#8A5E2E 100%);
      -webkit-background-clip:text;
      background-clip:text;
      -webkit-text-fill-color:transparent;
    }
  }

  .hb-hero--static .hb-hero__subtitle{
    color:var(--hb-ink-soft);
    text-shadow:none;
  }

  /* ---------- Product artwork ---------- */
  .hb-hero__art{
    position:relative;
    display:grid;
    place-items:center;
    z-index:1;
  }
  .hb-hero__art::before{
    content:"";
    position:absolute;
    width:min(78%,360px);
    aspect-ratio:1;
    border-radius:50%;
    background:radial-gradient(circle, rgba(201,162,39,.28) 0%, rgba(201,162,39,0) 68%);
    filter:blur(6px);
  }
  .hb-hero__bottle{
    position:relative;
    width:min(100%,300px);
    height:auto;
    filter:drop-shadow(0 26px 44px rgba(122,82,40,.28));
    animation:hb-float 7s ease-in-out infinite;
  }
  @keyframes hb-float{
    0%,100%{ transform:translateY(0); }
    50%    { transform:translateY(-12px); }
  }

  /* ---------- Perks strip ---------- */
  .hb-hero__perks{
    display:flex;
    flex-wrap:wrap;
    gap:10px 22px;
    margin:34px 0 0;
    padding:0;
    list-style:none;
    font-family:inherit;
    font-size:13px;
    line-height:1.7;
    color:var(--hb-ink-soft);
  }
  .hb-hero__perks li{
    display:inline-flex;
    align-items:center;
    gap:9px;
  }
  .hb-hero__perks li::before{
    content:"";
    flex:none;
    width:5px;
    height:5px;
    border-radius:50%;
    background:var(--hb-gold);
  }

  /* ============================================================
     RESPONSIVE
     ============================================================ */
  @media (max-width:900px){
    .hb-hero__slide{ min-height:clamp(400px,72vh,560px); }

    .hb-hero--static .hb-hero__content{
      grid-template-columns:1fr;
      text-align:center;
      justify-items:center;
      padding-block:clamp(48px,9vw,80px);
    }
    .hb-hero--static .hb-hero__inner{
      max-width:100%;
      text-align:center;
      order:2;
    }
    .hb-hero__art{
      order:1;
      margin-bottom:8px;
    }
    .hb-hero__bottle{ width:min(58%,190px); }
    .hb-hero__rule{ margin-inline:auto; }
    .hb-hero__perks{ justify-content:center; }
    .hb-hero--static .hb-hero__subtitle{ margin-inline:auto; }
  }

  @media (max-width:640px){
    .hb-hero__nav{ width:40px; height:40px; }
    .hb-hero__content{ padding-inline:20px; }
    .hb-hero__cta{ padding:14px 28px; font-size:14px; }
    .hb-hero__subtitle{ line-height:1.8; }
  }

  @media (prefers-reduced-motion:reduce){
    .hb-hero__bottle{ animation:none; }
    .hb-hero__track{ scroll-behavior:auto; }
    .hb-hero__cta,
    .hb-hero__nav,
    .hb-hero__dot{ transition:none; }
  }
</style>


{# ============================================================
   MARKUP
   ============================================================ #}
{% if hb_count > 0 %}

  {# ---------------- DYNAMIC SLIDER ---------------- #}
  <section class="hb-hero{% if hb_count > 1 %} hb-hero--slider{% endif %}"
           dir="rtl"
           aria-roledescription="carousel"
           aria-label="أبرز العروض"
           {% if hb_count > 1 %}data-hb-slider{% endif %}>

    <div class="hb-hero__viewport">
      <div class="hb-hero__track" data-hb-track>

        {% for slide in hb_slides %}

          {# --- image resolution --- #}
          {% set hb_img = '' %}
          {% if slide.image is defined and slide.image %}
            {% set hb_img = slide.image.url is defined and slide.image.url
                            ? slide.image.url
                            : (slide.image is not iterable ? slide.image : '') %}
          {% endif %}

          {# --- link resolution --- #}
          {% set hb_href = '#' %}
          {% if slide.url is defined and slide.url is not empty %}
            {% set hb_href = (slide.url is iterable and slide.url.url is defined) ? slide.url.url : slide.url %}
          {% endif %}

          <article class="hb-hero__slide"
                   data-hb-slide
                   role="group"
                   aria-roledescription="slide"
                   aria-label="{{ loop.index }} / {{ hb_count }}">

            {% if hb_img %}
              <div class="hb-hero__media">
                <img src="{{ hb_img }}"
                     alt="{{ slide.title|default('')|striptags }}"
                     loading="{{ loop.first ? 'eager' : 'lazy' }}"
                     {% if loop.first %}fetchpriority="high"{% endif %}
                     decoding="async">
              </div>
            {% endif %}

            <span class="hb-hero__scrim" aria-hidden="true"></span>

            <div class="hb-hero__content">
              <div class="hb-hero__inner">
                <span class="hb-hero__rule" aria-hidden="true"></span>

                {% if slide.title is defined and slide.title %}
                  <h2 class="hb-hero__title">{{ slide.title }}</h2>
                {% endif %}

                {% if slide.sub_title is defined and slide.sub_title %}
                  <p class="hb-hero__subtitle">{{ slide.sub_title }}</p>
                {% endif %}

                {% if slide.button_text is defined and slide.button_text %}
                  <a class="hb-hero__cta" href="{{ hb_href }}">
                    <span>{{ slide.button_text }}</span>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"
                         aria-hidden="true">
                      <path d="M19 12H5"/>
                      <path d="M11 6l-6 6 6 6"/>
                    </svg>
                  </a>
                {% endif %}
              </div>
            </div>

          </article>
        {% endfor %}

      </div>
    </div>

    {% if hb_count > 1 %}
      <button type="button" class="hb-hero__nav hb-hero__nav--prev"
              data-hb-prev aria-label="الشريحة السابقة">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor"
             stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M9 5l7 7-7 7"/>
        </svg>
      </button>

      <button type="button" class="hb-hero__nav hb-hero__nav--next"
              data-hb-next aria-label="الشريحة التالية">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor"
             stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M15 5l-7 7 7 7"/>
        </svg>
      </button>

      <ul class="hb-hero__dots" role="tablist" aria-label="التنقل بين الشرائح">
        {% for slide in hb_slides %}
          <li role="presentation">
            <button type="button"
                    class="hb-hero__dot{% if loop.first %} is-active{% endif %}"
                    data-hb-dot
                    role="tab"
                    aria-selected="{{ loop.first ? 'true' : 'false' }}"
                    aria-label="الشريحة {{ loop.index }}"></button>
          </li>
        {% endfor %}
      </ul>
    {% endif %}

  </section>


{% else %}

  {# ---------------- STATIC LUXURY FALLBACK ---------------- #}
  <section class="hb-hero hb-hero--static" dir="rtl" aria-label="مجموعة العطور الفاخرة">

    {# ---- Decorative arabesque pattern ---- #}
    <svg class="hb-hero__pattern" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
      <defs>
        <pattern id="hbPattern{{ hb_uid }}" width="84" height="84" patternUnits="userSpaceOnUse">
          <g fill="none" stroke="#A9763F" stroke-width="1" opacity="0.5">
            <path d="M42 8 L76 42 L42 76 L8 42 Z"/>
            <circle cx="42" cy="42" r="9"/>
            <path d="M42 26 L58 42 L42 58 L26 42 Z" opacity="0.55"/>
          </g>
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#hbPattern{{ hb_uid }})"/>
    </svg>

    <div class="hb-hero__content">

      {# ---- Copy ---- #}
      <div class="hb-hero__inner">
        <span class="hb-hero__rule" aria-hidden="true"></span>

        <h2 class="hb-hero__title">عطرٌ يحكي حكايتك</h2>

        <p class="hb-hero__subtitle">
          تشكيلة مختارة من العطور الشرقية النادرة، بمكوّنات فاخرة وثبات يدوم طويلاً.
          اكتشف عطرك الذي لا يُنسى من مجموعتنا الحصرية.
        </p>

        <a class="hb-hero__cta" href="#products">
          <span>اكتشف المجموعة</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
               stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"
               aria-hidden="true">
            <path d="M19 12H5"/>
            <path d="M11 6l-6 6 6 6"/>
          </svg>
        </a>

        <ul class="hb-hero__perks">
          <li>شحن مجاني للطلبات فوق ٣٠٠ ر.س</li>
          <li>إرجاع مجاني خلال ١٤ يوم</li>
          <li>عطور أصلية ١٠٠٪</li>
        </ul>
      </div>

      {# ---- Perfume flacon artwork ---- #}
      <div class="hb-hero__art" aria-hidden="true">
        <svg class="hb-hero__bottle" viewBox="0 0 240 360" fill="none"
             xmlns="http://www.w3.org/2000/svg">
          <defs>
            <linearGradient id="hbGold{{ hb_uid }}" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0"   stop-color="#E3C87A"/>
              <stop offset="0.5" stop-color="#C9A227"/>
              <stop offset="1"   stop-color="#8A5E2E"/>
            </linearGradient>
          </defs>

          <g stroke="url(#hbGold{{ hb_uid }})" stroke-width="1.6"
             stroke-linecap="round" stroke-linejoin="round" fill="none">

            <!-- cap -->
            <rect x="98" y="24" width="44" height="42" rx="9"/>
            <path d="M108 34h24" opacity="0.65"/>

            <!-- neck -->
            <rect x="106" y="64" width="28" height="34" rx="5"/>

            <!-- body -->
            <path d="M60 150
                     C60 112 84 98 120 98
                     C156 98 180 112 180 150
                     L180 262
                     C180 300 156 316 120 316
                     C84 316 60 300 60 262 Z"/>

            <!-- liquid level -->
            <path d="M62 214 C62 214 86 206 120 206 C154 206 178 214 178 214"
                  opacity="0.85"/>
            <path d="M62 214
                     C62 214 86 206 120 206 C154 206 178 214 178 214
                     L178 262 C178 300 156 316 120 316
                     C84 316 62 300 62 262 Z"
                  fill="url(#hbGold{{ hb_uid }})" opacity="0.14" stroke="none"/>

            <!-- label -->
            <rect x="88" y="156" width="64" height="78" rx="10"/>
            <path d="M102 180h36" opacity="0.8"/>
            <path d="M102 198h36" opacity="0.55"/>
            <path d="M102 214h22" opacity="0.45"/>

            <!-- sparkles -->
            <path d="M40 96 l6 6 -6 6 -6 -6 z" opacity="0.6"/>
            <path d="M198 250 l5 5 -5 5 -5 -5 z" opacity="0.5"/>
          </g>
        </svg>
      </div>

    </div>
  </section>

{% endif %}


{# ============================================================
   SCRIPT — slider controller (safe for multiple renders)
   ============================================================ #}
{% if hb_count > 1 %}
<script>
(function () {
  if (window.__hbHeroBooted) return;
  window.__hbHeroBooted = true;

  function initHero(root) {
    var track  = root.querySelector('[data-hb-track]');
    if (!track) return;

    var slides = Array.prototype.slice.call(track.querySelectorAll('[data-hb-slide]'));
    if (slides.length < 2) return;

    var dots   = Array.prototype.slice.call(root.querySelectorAll('[data-hb-dot]'));
    var prev   = root.querySelector('[data-hb-prev]');
    var next   = root.querySelector('[data-hb-next]');
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    var active = 0;
    var timer  = null;
    var raf    = null;
    var DELAY  = 6500;

    function setActive(i) {
      active = ((i % slides.length) + slides.length) % slides.length;
      for (var d = 0; d < dots.length; d++) {
        var on = d === active;
        dots[d].classList.toggle('is-active', on);
        dots[d].setAttribute('aria-selected', on ? 'true' : 'false');
      }
    }

    /* Rect-delta scroll works identically in LTR and RTL. */
    function goTo(i, immediate) {
      var target = slides[((i % slides.length) + slides.length) % slides.length];
      if (!target) return;

      var trackRect  = track.getBoundingClientRect();
      var targetRect = target.getBoundingClientRect();
      var delta      = targetRect.left - trackRect.left;

      track.scrollBy({
        left: delta,
        behavior: (immediate || reduce) ? 'auto' : 'smooth'
      });

      setActive(i);
    }

    /* Keep dots in sync with manual scroll / swipe */
    track.addEventListener('scroll', function () {
      if (raf) cancelAnimationFrame(raf);
      raf = requestAnimationFrame(function () {
        var trackRect = track.getBoundingClientRect();
        var best = 0;
        var bestDist = Infinity;

        for (var i = 0; i < slides.length; i++) {
          var dist = Math.abs(slides[i].getBoundingClientRect().left - trackRect.left);
          if (dist < bestDist) { bestDist = dist; best = i; }
        }
        if (best !== active) setActive(best);
      });
    }, { passive: true });

    /* Autoplay */
    function start() {
      if (reduce || timer) return;
      timer = setInterval(function () { goTo(active + 1); }, DELAY);
    }
    function stop() {
      if (timer) { clearInterval(timer); timer = null; }
    }

    if (prev) prev.addEventListener('click', function () { stop(); goTo(active - 1); start(); });
    if (next) next.addEventListener('click', function () { stop(); goTo(active + 1); start(); });

    dots.forEach(function (dot, i) {
      dot.addEventListener('click', function () { stop(); goTo(i); start(); });
    });

    root.addEventListener('pointerenter', stop);
    root.addEventListener('pointerleave', start);
    root.addEventListener('focusin', stop);
    root.addEventListener('focusout', start);
    root.addEventListener('touchstart', stop, { passive: true });

    document.addEventListener('visibilitychange', function () {
      if (document.hidden) { stop(); } else { start(); }
    });

    setActive(0);
    start();
  }

  function boot() {
    var heroes = document.querySelectorAll('.hb-hero[data-hb-slider]');
    for (var i = 0; i < heroes.length; i++) initHero(heroes[i]);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', boot);
  } else {
    boot();
  }
})();
</script>
{% endif %}