{# ============================================================
   components/store-features.twig — Dokhoon Iris
   Usage: {% include 'components.store-features' %}
   Dynamic mode: pass `features` array of { title, description, icon }.
   Classes map to dokhoon-iris.css sections 08, 25.
   ============================================================ #}
<section class="s-block s-block--features store-features" aria-label="مميزات المتجر">
  <div class="container">
    <div class="store-features__grid">

      {% if features is defined and features is not empty %}
        {# ---------- DYNAMIC MODE ---------- #}
        {% for feature in features %}
        <article class="feature-item store-features__card">
          <div class="store-features__icon" aria-hidden="true">
            {% if feature.icon is defined and feature.icon %}
              <img src="{{ feature.icon }}" alt="{{ feature.title|default('') }}" loading="lazy" width="32" height="32">
            {% else %}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 3l2.2 5.6L20 10.8l-5.8 2.2L12 18.6l-2.2-5.6L4 10.8l5.8-2.2z"/>
              </svg>
            {% endif %}
          </div>

          {% if feature.title is defined and feature.title %}
            <h3 class="feature-title">{{ feature.title }}</h3>
          {% endif %}

          {% if feature.description is defined and feature.description %}
            <p>{{ feature.description }}</p>
          {% endif %}
        </article>
        {% endfor %}

      {% else %}
        {# ---------- STATIC FALLBACK MODE ---------- #}

        <article class="feature-item store-features__card">
          <div class="store-features__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l2.2 5.6L20 10.8l-5.8 2.2L12 18.6l-2.2-5.6L4 10.8l5.8-2.2z"/></svg>
          </div>
          <h3 class="feature-title">جودة فاخرة</h3>
          <p>مكوّنات مختارة بعناية وعطور أصلية ١٠٠٪</p>
        </article>

        <article class="feature-item store-features__card">
          <div class="store-features__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="8" width="18" height="4" rx="1"/><path d="M12 8v13"/><path d="M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7"/><path d="M7.5 8a2.5 2.5 0 0 1 0-5C11 3 12 8 12 8s1-5 4.5-5a2.5 2.5 0 0 1 0 5"/></svg>
          </div>
          <h3 class="feature-title">تغليف هدايا أنيق</h3>
          <p>تغليف راقٍ يليق بأجمل المناسبات</p>
        </article>

        <article class="feature-item store-features__card">
          <div class="store-features__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7h11v10H3z"/><path d="M14 10h4l3 3v4h-7z"/><circle cx="7" cy="18" r="1.8"/><circle cx="17" cy="18" r="1.8"/></svg>
          </div>
          <h3 class="feature-title">شحن سريع</h3>
          <p>توصيل سريع وآمن إلى باب منزلك</p>
        </article>

        <article class="feature-item store-features__card">
          <div class="store-features__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v6c0 4.5-3 7.6-7 9-4-1.4-7-4.5-7-9V6z"/><path d="M9 12l2 2 4-4"/></svg>
          </div>
          <h3 class="feature-title">دفع آمن وموثوق</h3>
          <p>بوابات دفع مشفّرة وحماية كاملة لبياناتك</p>
        </article>

      {% endif %}

    </div>
  </div>
</section>
