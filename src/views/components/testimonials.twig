{# ============================================================
   components/testimonials.twig
   Testimonials / Customer Reviews Slider — Salla Twilight
   ------------------------------------------------------------
   Usage (simple):
     {% include 'components.testimonials' %}

   Usage (dynamic + overrides):
     {% include 'components.testimonials' with {
        testimonials: reviews,
        section_title: 'آراء عملائنا',
        section_subtitle: 'تجارب حقيقية من عملاء يثقون بنا'
     } %}
   ============================================================ #}

{# ---------- 1) Resolve the data source ---------- #}
{% set dynamic_items = [] %}

{% if testimonials is defined and testimonials is not empty %}
    {% set dynamic_items = testimonials %}
{% elseif reviews is defined and reviews is not empty %}
    {% set dynamic_items = reviews %}
{% endif %}

{# ---------- 2) Static luxury fallback (3 perfume reviews) ---------- #}
{% set fallback_items = [
    {
        name: 'نورة العتيبي',
        comment: 'عطر «مسك الليل» صار توقيعي الخاص، ثباته يدوم معي حتى نهاية اليوم، وكل من يقابلني يسألني عن اسمه. تجربة راقية تستحق كل ريال.',
        rating: 5,
        avatar: null,
        meta: 'عميلة موثّقة · الرياض'
    },
    {
        name: 'عبدالله الحربي',
        comment: 'طلبت المجموعة كهدية لزوجتي، والتغليف كان بمستوى الأفخم. رائحة العود الملكي راقية ومتوازنة، ووصل الطلب أسرع من المتوقع.',
        rating: 5,
        avatar: null,
        meta: 'عميل موثّق · جدة'
    },
    {
        name: 'لمى الشمري',
        comment: 'أكثر ما أعجبني أن العطر ناعم ويناسب النهار والمساء. خدمة العملاء ردّت بذوق وساعدتني في اختيار النوتة المناسبة لشخصيتي.',
        rating: 5,
        avatar: null,
        meta: 'عميلة موثّقة · الدمام'
    }
] %}

{% set list = dynamic_items is not empty ? dynamic_items : fallback_items %}

{% set heading    = section_title|default('آراء نعتز بها') %}
{% set subheading = section_subtitle|default('شهادات حقيقية من عملاء اختاروا الفخامة') %}

{# ============================================================
   MARKUP
   ============================================================ #}
<section class="tst-section" data-testimonials aria-labelledby="tst-heading">

    <div class="tst-inner">

        {# ---------- Header ---------- #}
        <header class="tst-header">
            <span class="tst-eyebrow">
                <i class="tst-line"></i>
                <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
                    <path d="M12 2.6l2.9 5.9 6.5.95-4.7 4.58 1.1 6.47L12 17.45 6.2 20.5l1.1-6.47-4.7-4.58 6.5-.95L12 2.6z"/>
                </svg>
                شهادات العملاء
                <i class="tst-line"></i>
            </span>

            <h2 class="tst-title" id="tst-heading">{{ heading }}</h2>

            {% if subheading is not empty %}
                <p class="tst-subtitle">{{ subheading }}</p>
            {% endif %}
        </header>

        {# ---------- Slider ---------- #}
        <div class="tst-viewport">
            <div class="tst-track" role="list">

                {% for item in list %}
                    {% set rating = (item.rating is defined and item.rating is not empty) ? item.rating : 5 %}
                    {% set name   = item.name|default('عميل') %}

                    <article class="tst-card" role="listitem">

                        {# Decorative quote mark #}
                        <svg class="tst-quote" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M9.5 5C6.5 6.6 5 9.2 5 12.8V19h6.4v-6.4H8.6c0-2.3.9-3.9 2.8-4.9L9.5 5zm9 0c-3 1.6-4.5 4.2-4.5 7.8V19h6.4v-6.4h-2.8c0-2.3.9-3.9 2.8-4.9L18.5 5z"/>
                        </svg>

                        {# Stars #}
                        <div class="tst-stars" aria-label="{{ rating }} من 5">
                            {% for i in 1..5 %}
                                <svg class="tst-star {{ i <= rating ? 'is-on' : '' }}"
                                     viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                                    <path d="M12 2.6l2.9 5.9 6.5.95-4.7 4.58 1.1 6.47L12 17.45 6.2 20.5l1.1-6.47-4.7-4.58 6.5-.95L12 2.6z"/>
                                </svg>
                            {% endfor %}
                        </div>

                        {# Comment #}
                        <p class="tst-comment">{{ item.comment|default('تجربة رائعة، أنصح بها بشدة.') }}</p>

                        {# Author #}
                        <footer class="tst-author">
                            <div class="tst-avatar">
                                {% if item.avatar is defined and item.avatar is not empty %}
                                    <img src="{{ item.avatar }}" alt="{{ name }}" loading="lazy" width="52" height="52">
                                {% else %}
                                    <span aria-hidden="true">{{ name|trim|slice(0, 1) }}</span>
                                {% endif %}
                            </div>

                            <div class="tst-author-info">
                                <span class="tst-name">{{ name }}</span>
                                <span class="tst-meta">
                                    {% if item.meta is defined and item.meta is not empty %}
                                        {{ item.meta }}
                                    {% else %}
                                        <svg viewBox="0 0 24 24" width="12" height="12" aria-hidden="true">
                                            <path d="M9 16.2l-3.5-3.5L4 14.2 9 19.2 20 8.2l-1.5-1.5z"/>
                                        </svg>
                                        عميل موثّق
                                    {% endif %}
                                </span>
                            </div>
                        </footer>

                    </article>
                {% endfor %}

            </div>
        </div>

        {# ---------- Nav (mobile / tablet only) ---------- #}
        {% if list|length > 1 %}
            <div class="tst-nav">
                <button type="button" class="tst-nav-btn" data-tst-dir="prev" aria-label="السابق">
                    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                        <path d="M14.7 5.3L8 12l6.7 6.7 1.4-1.4L10.8 12l5.3-5.3z"/>
                    </svg>
                </button>
                <button type="button" class="tst-nav-btn" data-tst-dir="next" aria-label="التالي">
                    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                        <path d="M9.3 5.3L8 6.7 13.2 12 8 17.3l1.3 1.4L16 12z"/>
                    </svg>
                </button>
            </div>
        {% endif %}

    </div>
</section>

{# ============================================================
   SCOPED STYLES
   ============================================================ #}
<style>
    .tst-section {
        --tst-cream:      #FBF6EE;
        --tst-cream-2:    #F3E9D7;
        --tst-gold:       #C6A15B;
        --tst-gold-deep:  #A17E3C;
        --tst-ink:        #2B2622;
        --tst-body:       #4C453D;
        --tst-muted:      #8A8075;
        --tst-card:       #FFFDF9;
        --tst-radius:     22px;

        position: relative;
        padding: clamp(2.75rem, 6vw, 5.5rem) 0;
        background:
            radial-gradient(1100px 420px at 50% -12%, rgba(198, 161, 91, .14), transparent 62%),
            linear-gradient(180deg, var(--tst-cream) 0%, var(--tst-cream-2) 100%);
        overflow: hidden;
        isolation: isolate;
    }

    /* soft gold texture */
    .tst-section::after {
        content: "";
        position: absolute;
        inset-inline-end: -120px;
        bottom: -140px;
        width: 420px;
        height: 420px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(198, 161, 91, .16), transparent 68%);
        pointer-events: none;
        z-index: -1;
    }

    .tst-inner {
        max-width: 1200px;
        margin-inline: auto;
        padding-inline: clamp(1rem, 4vw, 2rem);
    }

    /* ---------------- Header ---------------- */
    .tst-header {
        text-align: center;
        margin-bottom: clamp(1.75rem, 4vw, 3rem);
    }

    .tst-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: .6rem;
        font-size: .72rem;
        font-weight: 700;
        letter-spacing: .16em;
        text-transform: uppercase;
        color: var(--tst-gold-deep);
        margin-bottom: .9rem;
    }

    .tst-eyebrow svg { fill: var(--tst-gold); }

    .tst-line {
        display: inline-block;
        width: 34px;
        height: 1px;
        background: linear-gradient(90deg, transparent, var(--tst-gold));
    }

    .tst-eyebrow .tst-line:last-child {
        background: linear-gradient(90deg, var(--tst-gold), transparent);
    }

    .tst-title {
        margin: 0;
        font-size: clamp(1.5rem, 3.6vw, 2.35rem);
        font-weight: 800;
        line-height: 1.35;
        color: var(--tst-ink);
        letter-spacing: -.01em;
    }

    .tst-subtitle {
        margin: .75rem auto 0;
        max-width: 560px;
        font-size: clamp(.9rem, 1.8vw, 1rem);
        line-height: 1.9;
        color: var(--tst-muted);
    }

    /* ---------------- Track ---------------- */
    .tst-viewport { position: relative; }

    .tst-track {
        display: flex;
        gap: 1.25rem;
        margin: 0 -.25rem;
        padding: .75rem .25rem 1.75rem;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        scroll-behavior: smooth;
        scrollbar-width: none;
        -ms-overflow-style: none;
        -webkit-overflow-scrolling: touch;
    }

    .tst-track::-webkit-scrollbar { display: none; }

    /* ---------------- Card ---------------- */
    .tst-card {
        position: relative;
        flex: 0 0 86%;
        max-width: 430px;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        scroll-snap-align: center;
        padding: 1.85rem 1.5rem 1.4rem;
        background: var(--tst-card);
        border: 1px solid rgba(198, 161, 91, .28);
        border-radius: var(--tst-radius);
        box-shadow:
            0 14px 34px -22px rgba(43, 38, 34, .40),
            0 2px 6px rgba(43, 38, 34, .04);
        overflow: hidden;
        transition: transform .38s cubic-bezier(.22,.61,.36,1),
                    box-shadow .38s ease,
                    border-color .38s ease;
    }

    .tst-card::before {
        content: "";
        position: absolute;
        inset-inline: 0;
        top: 0;
        height: 3px;
        background: linear-gradient(90deg, transparent, var(--tst-gold), transparent);
        opacity: .6;
    }

    .tst-card:hover {
        transform: translateY(-6px);
        border-color: rgba(198, 161, 91, .55);
        box-shadow:
            0 28px 52px -26px rgba(43, 38, 34, .45),
            0 4px 10px rgba(43, 38, 34, .05);
    }

    /* ---------------- Quote icon ---------------- */
    .tst-quote {
        position: absolute;
        top: 1.35rem;
        inset-inline-end: 1.35rem;
        width: 42px;
        height: 42px;
        fill: var(--tst-gold);
        opacity: .16;
        pointer-events: none;
        transition: opacity .38s ease, transform .38s ease;
    }

    .tst-card:hover .tst-quote {
        opacity: .26;
        transform: scale(1.06);
    }

    /* ---------------- Stars ---------------- */
    .tst-stars {
        display: inline-flex;
        gap: .22rem;
        line-height: 0;
    }

    .tst-star {
        fill: #E7DFCF;
        transition: fill .3s ease;
    }

    .tst-star.is-on { fill: var(--tst-gold); }

    /* ---------------- Comment ---------------- */
    .tst-comment {
        flex: 1 1 auto;
        margin: 0;
        font-size: .97rem;
        line-height: 1.95;
        color: var(--tst-body);
        text-align: start;
    }

    /* ---------------- Author ---------------- */
    .tst-author {
        display: flex;
        align-items: center;
        gap: .85rem;
        padding-top: 1.1rem;
        border-top: 1px dashed rgba(198, 161, 91, .38);
    }

    .tst-avatar {
        flex: 0 0 auto;
        width: 52px;
        height: 52px;
        border-radius: 50%;
        display: grid;
        place-items: center;
        overflow: hidden;
        font-weight: 800;
        font-size: 1.15rem;
        color: #FFFDF9;
        background: linear-gradient(135deg, var(--tst-gold) 0%, var(--tst-gold-deep) 100%);
        border: 2px solid #fff;
        box-shadow: 0 0 0 2px rgba(198, 161, 91, .35);
    }

    .tst-avatar img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .tst-author-info {
        display: flex;
        flex-direction: column;
        gap: .18rem;
        min-width: 0;
    }

    .tst-name {
        font-size: .95rem;
        font-weight: 700;
        color: var(--tst-ink);
        line-height: 1.4;
    }

    .tst-meta {
        display: inline-flex;
        align-items: center;
        gap: .3rem;
        font-size: .76rem;
        color: var(--tst-muted);
    }

    .tst-meta svg { fill: var(--tst-gold); }

    /* ---------------- Nav buttons ---------------- */
    .tst-nav {
        display: flex;
        justify-content: center;
        gap: .75rem;
        margin-top: .35rem;
    }

    .tst-nav-btn {
        width: 44px;
        height: 44px;
        display: grid;
        place-items: center;
        border-radius: 50%;
        cursor: pointer;
        color: var(--tst-gold-deep);
        background: rgba(255, 253, 249, .9);
        border: 1px solid rgba(198, 161, 91, .45);
        box-shadow: 0 8px 20px -14px rgba(43, 38, 34, .5);
        transition: background .28s ease, color .28s ease, transform .28s ease, border-color .28s ease;
    }

    .tst-nav-btn svg { fill: currentColor; }

    .tst-nav-btn:hover {
        background: linear-gradient(135deg, var(--tst-gold), var(--tst-gold-deep));
        border-color: transparent;
        color: #FFFDF9;
        transform: translateY(-2px);
    }

    .tst-nav-btn:active { transform: translateY(0) scale(.96); }

    /* RTL icon flip for nav arrows */
    [dir="rtl"] .tst-nav-btn svg { transform: scaleX(-1); }

    /* ---------------- Breakpoints ---------------- */
    @media (min-width: 640px) {
        .tst-card { flex-basis: 47%; }
    }

    @media (min-width: 992px) {
        .tst-track {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 1.5rem;
            margin: 0;
            padding: .5rem 0 0;
            overflow: visible;
            scroll-snap-type: none;
        }

        .tst-card {
            flex: none;
            max-width: none;
            height: 100%;
        }

        .tst-nav { display: none; }
    }

    @media (prefers-reduced-motion: reduce) {
        .tst-track { scroll-behavior: auto; }
        .tst-card,
        .tst-quote,
        .tst-nav-btn { transition: none; }
    }
</style>

{# ============================================================
   SCOPED SCRIPT — mobile/tablet navigation only
   ============================================================ #}
<script>
    (function () {
        document.querySelectorAll('[data-testimonials]').forEach(function (root) {
            if (root.dataset.tstReady === '1') return;
            root.dataset.tstReady = '1';

            var track = root.querySelector('.tst-track');
            if (!track) return;

            var isRtl = getComputedStyle(root).direction === 'rtl';

            root.querySelectorAll('[data-tst-dir]').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var card = track.querySelector('.tst-card');
                    var step = card ? card.getBoundingClientRect().width + 20 : 320;
                    var dir = btn.getAttribute('data-tst-dir') === 'next' ? 1 : -1;

                    track.scrollBy({
                        left: dir * step * (isRtl ? -1 : 1),
                        behavior: 'smooth'
                    });
                });
            });
        });
    })();
</script>