{# ============================================================
   components/testimonials.twig
   Testimonials / Customer Reviews Slider — Dokhoon Iris
   Classes map to dokhoon-iris.css sections 09, 14, 22, 26
   ------------------------------------------------------------
   Usage (simple):
     {% include 'components.testimonials' %}

   Usage (dynamic + overrides):
     {% include 'components.testimonials' with {
        testimonials: reviews,
        section_title: 'آراء عملائنا',
        section_subtitle: 'تجارب حقيقية من عملاء يثقون بنا'
     } %}
   ============================================================ #}

{# ---------- 1) Resolve the data source ---------- #}
{% set dynamic_items = [] %}

{% if testimonials is defined and testimonials is not empty %}
    {% set dynamic_items = testimonials %}
{% elseif reviews is defined and reviews is not empty %}
    {% set dynamic_items = reviews %}
{% endif %}

{# ---------- 2) Static luxury fallback (3 perfume reviews) ---------- #}
{% set fallback_items = [
    {
        name: 'نورة العتيبي',
        comment: 'عطر «مسك الليل» صار توقيعي الخاص، ثباته يدوم معي حتى نهاية اليوم، وكل من يقابلني يسألني عن اسمه. تجربة راقية تستحق كل ريال.',
        rating: 5,
        avatar: null,
        meta: 'عميلة موثّقة · الرياض'
    },
    {
        name: 'عبدالله الحربي',
        comment: 'طلبت المجموعة كهدية لزوجتي، والتغليف كان بمستوى الأفخم. رائحة العود الملكي راقية ومتوازنة، ووصل الطلب أسرع من المتوقع.',
        rating: 5,
        avatar: null,
        meta: 'عميل موثّق · جدة'
    },
    {
        name: 'لمى الشمري',
        comment: 'أكثر ما أعجبني أن العطر ناعم ويناسب النهار والمساء. خدمة العملاء ردّت بذوق وساعدتني في اختيار النوتة المناسبة لشخصيتي.',
        rating: 5,
        avatar: null,
        meta: 'عميلة موثّقة · الدمام'
    }
] %}

{% set list = dynamic_items is not empty ? dynamic_items : fallback_items %}

{% set heading    = section_title|default('آراء نعتز بها') %}
{% set subheading = section_subtitle|default('شهادات حقيقية من عملاء اختاروا الفخامة') %}

{# ============================================================
   MARKUP
   ============================================================ #}
<section class="s-block s-block--testimonials tst-section" data-testimonials aria-labelledby="tst-heading">

    <div class="container tst-inner">

        {# ---------- Header ---------- #}
        <div class="s-block__title">
            <h2 id="tst-heading">{{ heading }}</h2>
        </div>
        {% if subheading is not empty %}
            <p class="s-block__subtitle">{{ subheading }}</p>
        {% endif %}

        {# ---------- Slider ---------- #}
        <div class="tst-viewport">
            <div class="tst-track" role="list">

                {% for item in list %}
                    {% set rating = (item.rating is defined and item.rating is not empty) ? item.rating : 5 %}
                    {% set name   = item.name|default('عميل') %}

                    <article class="tst-card" role="listitem">

                        {# Decorative quote mark #}
                        <svg class="tst-quote" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M9.5 5C6.5 6.6 5 9.2 5 12.8V19h6.4v-6.4H8.6c0-2.3.9-3.9 2.8-4.9L9.5 5zm9 0c-3 1.6-4.5 4.2-4.5 7.8V19h6.4v-6.4h-2.8c0-2.3.9-3.9 2.8-4.9L18.5 5z"/>
                        </svg>

                        {# Stars #}
                        <div class="tst-stars" aria-label="{{ rating }} من 5">
                            {% for i in 1..5 %}
                                <svg class="tst-star {{ i <= rating ? 'is-on' : '' }}"
                                     viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                                    <path d="M12 2.6l2.9 5.9 6.5.95-4.7 4.58 1.1 6.47L12 17.45 6.2 20.5l1.1-6.47-4.7-4.58 6.5-.95L12 2.6z"/>
                                </svg>
                            {% endfor %}
                        </div>

                        {# Comment #}
                        <p class="tst-comment">{{ item.comment|default('تجربة رائعة، أنصح بها بشدة.') }}</p>

                        {# Author #}
                        <footer class="tst-author">
                            <div class="tst-avatar">
                                {% if item.avatar is defined and item.avatar is not empty %}
                                    <img src="{{ item.avatar }}" alt="{{ name }}" loading="lazy" width="52" height="52">
                                {% else %}
                                    <span aria-hidden="true">{{ name|trim|slice(0, 1) }}</span>
                                {% endif %}
                            </div>

                            <div class="tst-author-info">
                                <span class="tst-name">{{ name }}</span>
                                <span class="tst-meta">
                                    {% if item.meta is defined and item.meta is not empty %}
                                        {{ item.meta }}
                                    {% else %}
                                        <svg viewBox="0 0 24 24" width="12" height="12" aria-hidden="true">
                                            <path d="M9 16.2l-3.5-3.5L4 14.2 9 19.2 20 8.2l-1.5-1.5z"/>
                                        </svg>
                                        عميل موثّق
                                    {% endif %}
                                </span>
                            </div>
                        </footer>

                    </article>
                {% endfor %}

            </div>
        </div>

        {# ---------- Nav (mobile / tablet only) ---------- #}
        {% if list|length > 1 %}
            <div class="tst-nav">
                <button type="button" class="tst-nav-btn" data-tst-dir="prev" aria-label="السابق">
                    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                        <path d="M14.7 5.3L8 12l6.7 6.7 1.4-1.4L10.8 12l5.3-5.3z"/>
                    </svg>
                </button>
                <button type="button" class="tst-nav-btn" data-tst-dir="next" aria-label="التالي">
                    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                        <path d="M9.3 5.3L8 6.7 13.2 12 8 17.3l1.3 1.4L16 12z"/>
                    </svg>
                </button>
            </div>
        {% endif %}

    </div>
</section>


{# ============================================================
   SCOPED SCRIPT — mobile/tablet navigation only
   ============================================================ #}
<script>
    (function () {
        document.querySelectorAll('[data-testimonials]').forEach(function (root) {
            if (root.dataset.tstReady === '1') return;
            root.dataset.tstReady = '1';

            var track = root.querySelector('.tst-track');
            if (!track) return;

            var isRtl = getComputedStyle(root).direction === 'rtl';

            root.querySelectorAll('[data-tst-dir]').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var card = track.querySelector('.tst-card');
                    var step = card ? card.getBoundingClientRect().width + 20 : 320;
                    var dir = btn.getAttribute('data-tst-dir') === 'next' ? 1 : -1;

                    track.scrollBy({
                        left: dir * step * (isRtl ? -1 : 1),
                        behavior: 'smooth'
                    });
                });
            });
        });
    })();
</script>