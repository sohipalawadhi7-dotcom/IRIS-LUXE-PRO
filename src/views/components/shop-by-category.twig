{# ============================================================
   Component: Shop by Category (تسوق حسب الفئة)
   Location: Twilight Theme / Components
   Usage: {% include 'components.shop-by-category' %}
   Compatible with: Salla Twilight (category.image is Object)
   ============================================================ #}

<style>
    /* ====== Scoped Styles: shop-by-category ====== */
    .shop-category-section {
        --sc-bg-beige: #f4f0eb;
        --sc-text-bronze: #7a5c3e;
        --sc-text-dark-brown: #4a3b2c;
        --sc-gold-accent: #b8936e;
        --sc-card-bg: #ffffff;
        --sc-shadow-soft: 0 8px 20px rgba(0, 0, 0, 0.04), 0 2px 6px rgba(0, 0, 0, 0.02);
        --sc-shadow-hover: 0 16px 30px rgba(0, 0, 0, 0.08), 0 6px 12px rgba(0, 0, 0, 0.05);
        --sc-radius: 16px;
        --sc-transition: all 0.25s ease;

        font-family: 'Cairo', 'Tajawal', sans-serif;
        background-color: var(--sc-bg-beige);
        padding: 2rem 1rem;
        width: 100%;
        display: block;
        direction: rtl;
    }

    .shop-category-section__title {
        text-align: center;
        font-size: 2rem;
        font-weight: 700;
        color: var(--sc-text-bronze);
        letter-spacing: 0.5px;
        margin: 0 auto 2.5rem;
        position: relative;
        display: block;
        width: fit-content;
        white-space: nowrap;
    }

    .shop-category-section__title::after {
        content: '';
        display: block;
        width: 70px;
        height: 3px;
        background: linear-gradient(90deg, transparent, var(--sc-gold-accent), transparent);
        margin: 0.6rem auto 0;
        border-radius: 4px;
    }

    .shop-category-section__grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1.5rem;
        justify-content: center;
        align-items: stretch;
        max-width: 1280px;
        margin: 0 auto;
        padding: 0.5rem;
    }

    .shop-category-card {
        background-color: var(--sc-card-bg);
        border-radius: var(--sc-radius);
        box-shadow: var(--sc-shadow-soft);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: flex-start;
        text-align: center;
        padding: 1.5rem 0.8rem 1.4rem;
        transition: var(--sc-transition);
        cursor: pointer;
        text-decoration: none;
        color: inherit;
        border: 1px solid rgba(184, 147, 110, 0.12);
        height: 100%;
    }

    .shop-category-card:hover {
        transform: translateY(-6px);
        box-shadow: var(--sc-shadow-hover);
        border-color: rgba(184, 147, 110, 0.3);
    }

    .shop-category-card:focus-visible {
        outline: 2px solid var(--sc-gold-accent);
        outline-offset: 3px;
    }

    .shop-category-card__image-wrapper {
        width: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
        margin-bottom: 1rem;
        min-height: 100px;
    }

    .shop-category-card__image {
        width: 85px;
        height: 85px;
        object-fit: contain;
        display: block;
        transition: transform 0.3s ease;
        border-radius: 8px;
    }

    .shop-category-card:hover .shop-category-card__image {
        transform: scale(1.05);
    }

    /* Placeholder SVG عند غياب الصورة */
    .shop-category-card__placeholder {
        width: 85px;
        height: 85px;
        display: block;
        transition: transform 0.3s ease;
    }

    .shop-category-card:hover .shop-category-card__placeholder {
        transform: scale(1.05);
    }

    .shop-category-card__title {
        font-size: 1.25rem;
        font-weight: 600;
        color: var(--sc-text-dark-brown);
        margin-bottom: 0.5rem;
        line-height: 1.4;
        letter-spacing: 0.3px;
        transition: color 0.2s ease;
    }

    .shop-category-card:hover .shop-category-card__title {
        color: var(--sc-text-bronze);
    }

    .shop-category-card__icon {
        font-size: 1.6rem;
        line-height: 1;
        color: var(--sc-gold-accent);
        margin-top: 0.2rem;
        opacity: 0.9;
        transition: opacity 0.2s ease, transform 0.2s ease;
    }

    .shop-category-card:hover .shop-category-card__icon {
        opacity: 1;
        transform: translateY(2px);
    }

    .shop-category-card__icon svg {
        width: 28px;
        height: 28px;
        fill: none;
        stroke: var(--sc-gold-accent);
        stroke-width: 1.8;
        stroke-linecap: round;
        stroke-linejoin: round;
        display: block;
        margin: 0 auto;
    }

    @media (max-width: 992px) {
        .shop-category-section__grid { gap: 1rem; }
        .shop-category-card { padding: 1.2rem 0.5rem 1rem; }
        .shop-category-card__title { font-size: 1.1rem; }
        .shop-category-card__image,
        .shop-category-card__placeholder { width: 70px; height: 70px; }
        .shop-category-card__icon svg { width: 24px; height: 24px; }
    }

    @media (max-width: 768px) {
        .shop-category-section { padding: 1.5rem 0.75rem; }
        .shop-category-section__title {
            font-size: 1.7rem;
            white-space: normal;
            width: 100%;
            padding: 0 0.5rem;
        }
        .shop-category-section__grid {
            grid-template-columns: repeat(2, 1fr);
            gap: 1rem;
        }
        .shop-category-card { padding: 1rem 0.5rem; }
        .shop-category-card__image-wrapper { min-height: 80px; }
        .shop-category-card__image,
        .shop-category-card__placeholder { width: 65px; height: 65px; }
        .shop-category-card__title { font-size: 1rem; }
        .shop-category-card__icon svg { width: 22px; height: 22px; }
    }

    @media (max-width: 480px) {
        .shop-category-section__grid { gap: 0.8rem; }
        .shop-category-card__image,
        .shop-category-card__placeholder { width: 55px; height: 55px; }
        .shop-category-card__title { font-size: 0.9rem; }
        .shop-category-card__icon svg { width: 20px; height: 20px; }
    }
</style>

{# ============================================================
   Section Markup
   ============================================================ #}
<section class="shop-category-section" aria-labelledby="shopByCategoryTitle">
    <h2 id="shopByCategoryTitle" class="shop-category-section__title">
        {{ trans('blocks.home.shop_by_category') | default('تسوق حسب الفئة') }}
    </h2>

    <div class="shop-category-section__grid">

        {# ==================================================
           الوضع الديناميكي (Dynamic Mode)
           يُفعَّل تلقائياً عند تمرير متغيّر categories.
           مثال:
           {% include 'components.shop-by-category'
              with { categories: salla.categories() } %}
           ================================================== #}
        {% if categories is defined and categories is not empty %}

            {% for category in categories %}
                <a href="{{ category.url | default('#') }}"
                   class="shop-category-card"
                   aria-label="{{ category.name | default('فئة') }}"
                   title="{{ category.name | default('') }}">

                    <div class="shop-category-card__image-wrapper">

                        {# ✅ فحص آمن: category.image كائن وليس نصاً #}
                        {% if category.image is defined
                              and category.image is not empty
                              and category.image.url is defined
                              and category.image.url is not empty %}

                            <img src="{{ category.image.url }}"
                                 alt="{{ category.image.alt | default(category.name | default('صورة الفئة')) }}"
                                 class="shop-category-card__image"
                                 loading="lazy"
                                 width="85"
                                 height="85"
                                 onerror="this.style.display='none'; this.nextElementSibling.style.display='block';">

                            {# Placeholder مخفي احتياطياً في حال فشل تحميل الصورة #}
                            <svg class="shop-category-card__placeholder"
                                 style="display:none;"
                                 viewBox="0 0 100 100"
                                 xmlns="http://www.w3.org/2000/svg"
                                 aria-hidden="true">
                                <rect x="15" y="15" width="70" height="70" rx="12"
                                      stroke="#b8936e" stroke-width="2" fill="#faf7f2"/>
                                <circle cx="38" cy="42" r="6"
                                        stroke="#b8936e" stroke-width="1.8" fill="none"/>
                                <path d="M20 72 L40 52 L55 65 L70 50 L82 62"
                                      stroke="#b8936e" stroke-width="2"
                                      fill="none" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>

                        {% else %}

                            {# عرض Placeholder SVG فقط عند غياب الصورة تماماً #}
                            <svg class="shop-category-card__placeholder"
                                 viewBox="0 0 100 100"
                                 xmlns="http://www.w3.org/2000/svg"
                                 role="img"
                                 aria-label="{{ category.name | default('فئة') }}">
                                <rect x="15" y="15" width="70" height="70" rx="12"
                                      stroke="#b8936e" stroke-width="2" fill="#faf7f2"/>
                                <circle cx="38" cy="42" r="6"
                                        stroke="#b8936e" stroke-width="1.8" fill="none"/>
                                <path d="M20 72 L40 52 L55 65 L70 50 L82 62"
                                      stroke="#b8936e" stroke-width="2"
                                      fill="none" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>

                        {% endif %}

                    </div>

                    <span class="shop-category-card__title">
                        {{ category.name | default('فئة') }}
                    </span>

                    {# عرض أيقونة الفئة إذا كان الحقل موجوداً (HTML/SVG جاهز من سلة) #}
                    {% if category.icon is defined and category.icon is not empty %}
                        <span class="shop-category-card__icon" aria-hidden="true">
                            {{ category.icon | raw }}
                        </span>
                    {% endif %}

                </a>
            {% endfor %}

        {% else %}

            {# ==================================================
               الوضع الثابت (Static Fallback Mode)
               يظهر عند المعاينة أو عدم تمرير categories.
               ================================================== #}

            {# البطاقة 1: العطور #}
            <a href="#" class="shop-category-card" aria-label="تسوق العطور">
                <div class="shop-category-card__image-wrapper">
                    <svg class="shop-category-card__image" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="زجاجة عطر">
                        <rect x="30" y="35" width="40" height="50" rx="8" stroke="#b8936e" stroke-width="2.2" fill="#faf7f2"/>
                        <rect x="40" y="18" width="20" height="12" rx="3" stroke="#b8936e" stroke-width="2.2" fill="#f0e8de"/>
                        <line x1="50" y1="30" x2="50" y2="35" stroke="#b8936e" stroke-width="2.2"/>
                        <circle cx="50" cy="15" r="3" fill="#b8936e" opacity="0.7"/>
                        <line x1="38" y1="55" x2="62" y2="55" stroke="#b8936e" stroke-width="1.5" opacity="0.5"/>
                        <line x1="38" y1="65" x2="58" y2="65" stroke="#b8936e" stroke-width="1.5" opacity="0.4"/>
                    </svg>
                </div>
                <span class="shop-category-card__title">عطور</span>
                <span class="shop-category-card__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24">
                        <path d="M9 3h6v3H9V3zM7 6h10v13a2 2 0 01-2 2H9a2 2 0 01-2-2V6z" stroke="currentColor" fill="none"/>
                        <path d="M12 3v3" stroke="currentColor"/>
                        <circle cx="12" cy="2" r="1" fill="currentColor" stroke="none"/>
                    </svg>
                </span>
            </a>

            {# البطاقة 2: البخور #}
            <a href="#" class="shop-category-card" aria-label="تسوق البخور">
                <div class="shop-category-card__image-wrapper">
                    <svg class="shop-category-card__image" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="بخور">
                        <path d="M25 70 L75 70 L68 85 L32 85 Z" stroke="#b8936e" stroke-width="2.2" fill="#f0e8de"/>
                        <path d="M35 45 L65 45 L65 70 L35 70 Z" stroke="#b8936e" stroke-width="2.2" fill="#faf7f2"/>
                        <path d="M45 45 Q48 35 45 25 Q42 15 45 5" stroke="#b8936e" stroke-width="2" stroke-linecap="round" opacity="0.6"/>
                        <path d="M55 45 Q58 35 55 25 Q52 15 55 5" stroke="#b8936e" stroke-width="2" stroke-linecap="round" opacity="0.4"/>
                        <rect x="42" y="38" width="16" height="5" rx="2" fill="#b8936e" opacity="0.7"/>
                    </svg>
                </div>
                <span class="shop-category-card__title">بخور</span>
                <span class="shop-category-card__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24">
                        <path d="M12 21V12" stroke="currentColor" stroke-width="1.8"/>
                        <path d="M8 21V12" stroke="currentColor" stroke-width="1.8"/>
                        <path d="M16 21V12" stroke="currentColor" stroke-width="1.8"/>
                        <path d="M6 8L12 3L18 8" stroke="currentColor" stroke-width="1.8" fill="none"/>
                        <circle cx="12" cy="5" r="1.5" fill="currentColor" stroke="none"/>
                    </svg>
                </span>
            </a>

            {# البطاقة 3: العود #}
            <a href="#" class="shop-category-card" aria-label="تسوق العود">
                <div class="shop-category-card__image-wrapper">
                    <svg class="shop-category-card__image" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="عود">
                        <path d="M30 40 L70 35 L78 55 L65 75 L35 78 L22 58 Z" stroke="#b8936e" stroke-width="2.2" fill="#f5ede3"/>
                        <path d="M38 45 L62 42" stroke="#b8936e" stroke-width="1.5" opacity="0.5"/>
                        <path d="M35 55 L65 52" stroke="#b8936e" stroke-width="1.5" opacity="0.4"/>
                        <path d="M32 65 L60 62" stroke="#b8936e" stroke-width="1.5" opacity="0.3"/>
                        <ellipse cx="48" cy="52" rx="5" ry="3" stroke="#b8936e" stroke-width="1.2" fill="none" opacity="0.7"/>
                    </svg>
                </div>
                <span class="shop-category-card__title">عود</span>
                <span class="shop-category-card__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24">
                        <path d="M4 16L8 8L16 6L20 12L16 18L8 20L4 16Z" stroke="currentColor" stroke-width="1.6" fill="none"/>
                        <path d="M12 11L16 10" stroke="currentColor" stroke-width="1.5"/>
                        <circle cx="10" cy="14" r="1.2" fill="currentColor" stroke="none"/>
                    </svg>
                </span>
            </a>

            {# البطاقة 4: أطقم الهدايا #}
            <a href="#" class="shop-category-card" aria-label="تسوق أطقم الهدايا">
                <div class="shop-category-card__image-wrapper">
                    <svg class="shop-category-card__image" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="حقيبة هدايا">
                        <rect x="25" y="38" width="50" height="42" rx="6" stroke="#b8936e" stroke-width="2.2" fill="#faf7f2"/>
                        <path d="M40 38 L40 28 Q40 18 50 18 Q60 18 60 28 L60 38" stroke="#b8936e" stroke-width="2.2" fill="none"/>
                        <rect x="45" y="38" width="10" height="42" fill="#b8936e" opacity="0.2"/>
                        <circle cx="50" cy="48" r="5" fill="none" stroke="#b8936e" stroke-width="1.8"/>
                        <path d="M45 45 L40 40" stroke="#b8936e" stroke-width="1.8"/>
                        <path d="M55 45 L60 40" stroke="#b8936e" stroke-width="1.8"/>
                        <path d="M45 51 L40 56" stroke="#b8936e" stroke-width="1.8"/>
                        <path d="M55 51 L60 56" stroke="#b8936e" stroke-width="1.8"/>
                    </svg>
                </div>
                <span class="shop-category-card__title">أطقم هدايا</span>
                <span class="shop-category-card__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24">
                        <rect x="4" y="9" width="16" height="12" rx="2" stroke="currentColor" stroke-width="1.8" fill="none"/>
                        <path d="M8 9V6a4 4 0 018 0v3" stroke="currentColor" stroke-width="1.8" fill="none"/>
                        <line x1="12" y1="9" x2="12" y2="21" stroke="currentColor" stroke-width="1.5"/>
                        <circle cx="12" cy="14" r="1.5" fill="currentColor" stroke="none"/>
                    </svg>
                </span>
            </a>

        {% endif %}

    </div>
</section>