{#
  pages/cart.twig — shopping cart (luxury layout).
  Uses: cart.items, salla-quantity-input, salla.cart.deleteItem, salla-cart-coupons, salla-cart-summary-card
  (totals + checkout button), salla-offer. New classes are prefixed `lx-` and scoped below.
#}
{% extends "layouts.master" %}

{% block content %}
<style>
  .lx-cart {
    --color-primary: var(--accent-btn);
    --color-primary-dark: var(--accent-dark-gold);
    --color-primary-light: var(--accent-gold);
    --color-primary-reverse: #fff;
    font-family: var(--font-family);
    color: var(--text-primary);
  }
  .lx-crumbs { padding-block: 18px 0; font-size: .85rem; color: var(--text-muted); }
  .lx-layout { display: grid; grid-template-columns: minmax(0, 1fr) 380px; gap: clamp(20px, 3vw, 40px); align-items: start; }
  .lx-items { display: flex; flex-direction: column; gap: 14px; }
  .lx-item { display: grid; grid-template-columns: 96px minmax(0, 1fr) auto auto auto; align-items: center; gap: 18px; padding: 16px; background: var(--bg-card); border: 1px solid var(--border-color); border-radius: var(--radius); box-shadow: var(--shadow); }
  .lx-item__img { display: block; width: 96px; aspect-ratio: 1; border-radius: calc(var(--radius) - 2px); overflow: hidden; background: var(--bg-media); }
  .lx-item__img img { width: 100%; height: 100%; object-fit: cover; }
  .lx-item__name { display: block; font-weight: 700; line-height: 1.5; }
  .lx-item__name:hover { color: var(--accent-btn); }
  .lx-item__price { display: block; margin-top: 4px; color: var(--text-muted); font-size: .9rem; }
  .lx-item__total { margin: 0; text-align: end; min-width: 110px; }
  .lx-item__total span:first-child { display: block; font-size: .78rem; color: var(--text-muted); }
  .lx-item__total .item-total { font-weight: 700; color: var(--accent-btn); }
  .lx-summary { position: sticky; top: calc(var(--header-h, 84px) + 16px); display: flex; flex-direction: column; gap: 14px; padding: 20px; background: var(--bg-card); border: 1px solid var(--border-color); border-radius: var(--radius); box-shadow: var(--shadow); }
  .lx-empty { text-align: center; padding: clamp(40px, 8vw, 90px) 20px; background: var(--bg-card); border: 1px solid var(--border-color); border-radius: var(--radius); }
  .lx-empty i { font-size: 3rem; color: var(--accent-gold); }
  .lx-empty p { margin: 14px 0 22px; font-size: 1.1rem; color: var(--text-muted); }
  @media (max-width: 960px) { .lx-layout { grid-template-columns: 1fr; } .lx-summary { position: static; } }
  @media (max-width: 640px) {
    .lx-item { grid-template-columns: 80px minmax(0, 1fr) auto; }
    .lx-item__img { width: 80px; }
    .lx-item__qty { grid-column: 2; }
    .lx-item__total { grid-column: 2; text-align: start; }
    .lx-item__remove { grid-column: 3; grid-row: 1; }
  }
</style>

<div class="lx-cart">
  <div class="container section">
    <nav class="lx-crumbs"><salla-breadcrumb></salla-breadcrumb></nav>
    <h1 class="section-title">{{ trans('blocks.header.cart') }}</h1>

    <div class="lx-layout">
      <div class="lx-items">
        {% hook 'cart:items.start' %}

        {% for item in cart.items %}
          <form onchange="salla.form.onChange('cart.updateItem', event)" id="item-{{ item.id }}">
            <section class="lx-item">
              <input type="hidden" name="id" value="{{ item.id }}">

              <a href="{{ item.url }}" class="lx-item__img">
                <img src="{{ item.product_image }}" alt="{{ item.product_name }}" loading="{{ loop.first ? 'eager' : 'lazy' }}">
              </a>

              <div class="lx-item__info">
                <a class="lx-item__name" href="{{ item.url }}">{{ item.product_name }}</a>
                <span class="lx-item__price item-price">{{ item.price|money }}</span>
              </div>

              <div class="lx-item__qty">
                {% if item.is_hidden_quantity or item.type == 'donating' %}
                  <input type="hidden" value="{{ item.quantity }}" name="quantity" aria-label="Quantity">
                  <span>{{ item.quantity }}</span>
                {% else %}
                  <salla-quantity-input cart-item-id="{{ item.id }}" max="{{ item.max_quantity }}" value="{{ item.quantity }}" name="quantity" aria-label="Quantity"></salla-quantity-input>
                {% endif %}
              </div>

              <p class="lx-item__total">
                <span>{{ trans('pages.cart.total') }}</span>
                <span class="item-total">{{ item.is_available ? item.total|money : trans('pages.cart.out_of_stock') }}</span>
              </p>

              <salla-button class="lx-item__remove btn--delete" type="button" shape="icon" size="small" color="danger" aria-label="Remove from the cart"
                onclick="salla.cart.deleteItem('{{ item.id }}').then(() => document.querySelector('#item-{{ item.id }}').remove())">
                <i class="sicon-cancel"></i>
              </salla-button>
            </section>
          </form>
        {% else %}
          <div class="lx-empty">
            <i class="sicon-shopping-bag"></i>
            <p>{{ trans('pages.cart.empty_cart') }}</p>
            <a class="btn" href="{{ store.url }}">{{ trans('common.elements.back_home') }}</a>
          </div>
        {% endfor %}

        <salla-offer></salla-offer>
        {% hook 'cart:items.end' %}
      </div>

      {% if cart.items|length %}
        <aside class="lx-summary">
          {% hook 'cart:summary.start' %}
          {% if store.settings.cart.apply_coupon_enabled %}
            <salla-cart-coupons></salla-cart-coupons>
          {% endif %}
          {# totals + checkout CTA are rendered by this component #}
          <salla-cart-summary-card></salla-cart-summary-card>
          {% hook 'cart:summary.end' %}
        </aside>
      {% endif %}
    </div>
  </div>
</div>
{% endblock %}
